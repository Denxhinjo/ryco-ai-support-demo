# ── Groq ────────────────────────────────────────────────
# Get yours at: https://console.groq.com/keys  (free, no credit card)
GROQ_API_KEY=gsk_...

# ── Supabase ────────────────────────────────────────────
# Get yours at: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # use the service_role key (not anon)

# ── Resend (email) ──────────────────────────────────────
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# ── Email config ─────────────────────────────────────────
# The "from" address — must be a domain you've verified in Resend
# For testing you can use: onboarding@resend.dev (Resend's sandbox)
FROM_EMAIL=IT Support <it-support@yourdomain.com>
